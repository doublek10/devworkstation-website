# Copy this file to .env.local for local development
# (in Vercel: Project Settings -> Environment Variables, add the same key/value)

# Base URL of the cPanel PHP backend (cpanel-backend/), no trailing slash.
# Must be NEXT_PUBLIC_-prefixed: the activation form calls it directly from
# the browser, and Next.js only exposes NEXT_PUBLIC_* vars to client code.
NEXT_PUBLIC_ACTIVATION_API_BASE=https://yourdomain.com/cpanel-backend
